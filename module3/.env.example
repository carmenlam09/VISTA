# Copy to .env and fill in for real-provider mode. All values are optional;
# the app runs fully on the deterministic fallback categorizer and bundled
# fixtures with no .env file at all.

# Path to Module 2's SQLite database, read-only. Defaults to
# ../module2/backend/database/screening.db relative to the repo root. If
# missing, Module 3 falls back to bundled fixture adverse-news bundles.
MODULE2_DB_PATH=

# Path to Module 1's SQLite database, read-only, used only to resolve an
# entity_id to its legal_name/aliases for the relevance filter. Defaults to
# ../module1/database/vista.db relative to the repo root.
MODULE1_DB_PATH=

# When set, the categorization service calls the real Anthropic API. When
# unset, it uses the deterministic local fallback categorizer (no network,
# no key required).
ANTHROPIC_API_KEY=
