# Copy to .env and fill in for real-provider mode. All values are optional;
# the app runs fully on the deterministic fallback and bundled fixtures with
# no .env file at all.

# Module 5's own SQLite database (draft assessments + edit/approval history).
DATABASE_URL=

# Path to Module 1's SQLite database, read-only, used to resolve entity
# profiles for policy rules that key on entity attributes.
MODULE1_DB_PATH=

# Path to Module 2's SQLite database, read-only, used only to recover the
# risk theme(s) on Module 2-sourced findings — Module 4's FindingSummary
# doesn't carry theme through, so Module 5 re-reads the original hit.
MODULE2_DB_PATH=

# Path to Module 4's SQLite database, read-only — Module 5's primary input
# (the ranked, triaged findings per entity).
MODULE4_DB_PATH=

# Module 3's base URL, used the same way Module 4 uses it: to recover theme
# on Module 3-sourced (adverse-media) findings. Module 3 has no database of
# its own, so this is a live HTTP call, falling back to fixtures if
# unreachable.
MODULE3_BASE_URL=http://localhost:8001

# When set, the narrative service calls the real Anthropic API. When unset,
# it uses the deterministic local fallback (no network, no key required).
ANTHROPIC_API_KEY=
