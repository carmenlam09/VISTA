# Copy to .env and fill in for real-provider mode. All values are optional;
# the app runs fully on the deterministic fallback and bundled fixtures with
# no .env file at all.

# Module 4's own SQLite database (triage results + audit/override log).
# Defaults to ./database/triage.db relative to this file.
DATABASE_URL=

# Path to Module 1's SQLite database, read-only, used to resolve entity
# profiles (name/aliases/nationality/ID/related entities). Defaults to
# ../module1/database/vista.db relative to the repo root.
MODULE1_DB_PATH=

# Path to Module 2's SQLite database, read-only, used to read the entity's
# aggregated screening results across all 5 sources. Defaults to
# ../module2/backend/database/screening.db relative to the repo root.
MODULE2_DB_PATH=

# Module 3's base URL. Module 3 is stateless (no database of its own), so
# "live" adverse-media findings are pulled over HTTP, not read from a file —
# unlike the Module 1/2 reads, this requires Module 3's server to be
# running. If unreachable, Module 4 falls back to fixtures for that entity.
MODULE3_BASE_URL=http://localhost:8001

# When set, the reasoning service calls the real Anthropic API. When unset,
# it uses the deterministic local fallback scorer (no network, no key
# required).
ANTHROPIC_API_KEY=
