# Copy to .env and fill in for real-provider mode. All values are optional;
# the app runs fully on the deterministic local extractor with no .env file
# at all.

# Gemini extraction. Without this, entity extraction uses the included
# deterministic local extractor (SSM-report-aware, plus a generic labeled-text
# fallback).
GEMINI_API_KEY=

# Module 1's own SQLite database. Defaults to ./database/vista.db relative to
# this file — the same file/schema Module 1 has always used, so Modules 2-7
# keep reading it unchanged.
DATABASE_URL=

# Base URL the Streamlit UI (ui/) uses to reach this module's own FastAPI
# backend.
API_BASE_URL=http://localhost:8000
