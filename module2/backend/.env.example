# Copy to .env and fill in for real-provider mode. All values are optional;
# the app runs fully on mocks/fallbacks with no .env file at all.

# Database (defaults to a local SQLite file under module2/backend/database/).
# Point this at a Postgres DSN in production, e.g.:
# DATABASE_URL=postgresql+psycopg://vista:password@localhost:5432/vista_screening
DATABASE_URL=

# Path to Module 1's SQLite database, read-only. Defaults to
# ../../module1/database/vista.db relative to this file. If the file does not
# exist, Module 2 falls back to bundled fixture entities automatically.
MODULE1_DB_PATH=

# When set, SummaryGenerator calls the real Anthropic API. When unset, it uses
# the deterministic local fallback summarizer (no network, no key required).
ANTHROPIC_API_KEY=

# Cache TTL, in seconds, before a source is considered stale and re-queried.
SCREENING_CACHE_TTL_SECONDS=3600
