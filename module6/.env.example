# Copy to .env and fill in for real-provider mode. All values are optional;
# the app runs fully on the deterministic fallback and bundled fixtures with
# no .env file at all.

# Module 6's own SQLite database (report versions + status history).
DATABASE_URL=

# Path to Module 1's SQLite database, read-only.
MODULE1_DB_PATH=

# Path to Module 2's SQLite database, read-only — aggregated screening
# evidence across all five sources.
MODULE2_DB_PATH=

# Module 3's base URL — Module 3 has no database of its own (stateless), so
# adverse-media findings are pulled live over HTTP, falling back to fixtures
# if unreachable.
MODULE3_BASE_URL=http://localhost:8001

# Path to Module 4's SQLite database, read-only — triaged findings.
MODULE4_DB_PATH=

# Path to Module 5's SQLite database, read-only — the LATEST risk assessment
# state (reviewer-edited, if applicable), not a cached first pass.
MODULE5_DB_PATH=

# Path to the report template config (the placeholder structure until the
# bank's real template is provided — see README).
REPORT_TEMPLATE_PATH=

# When set, the narrative service calls the real Anthropic API. When unset,
# it uses the deterministic local fallback (no network, no key required).
ANTHROPIC_API_KEY=
