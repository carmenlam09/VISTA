# Copy to .env and fill in for real-provider mode. All values are optional;
# the app runs fully on the local deterministic embedding provider and
# bundled fixtures with no .env file at all.

# Module 7's own SQLite database (knowledge records, never hard-deleted).
DATABASE_URL=

# Path to the retention policy config (placeholder values pending compliance
# confirmation — see README).
RETENTION_POLICY_PATH=

# Embedding dimensionality for the local hashed-TF provider.
EMBEDDING_DIMENSIONS=256
